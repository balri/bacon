#!/bin/sh
set -e

ROOT="$(git rev-parse --show-toplevel)"

echo ""
echo "=== Web app: format ==="
cd "$ROOT"
npm run format
git add -A "$ROOT/.gitignore" "$ROOT/.prettierignore" "$ROOT/.prettierrc" \
	"$ROOT/.stylelintrc" "$ROOT/README.md" "$ROOT/api" "$ROOT/eslint.config.js" \
	"$ROOT/index.html" "$ROOT/package-lock.json" "$ROOT/package.json" \
	"$ROOT/server" "$ROOT/src" "$ROOT/tsconfig.app.json" \
	"$ROOT/tsconfig.eslint.json" "$ROOT/tsconfig.json" \
	"$ROOT/tsconfig.node.json" "$ROOT/vercel.json" "$ROOT/vite.config.ts" \
	"$ROOT/vitest.config.ts"

echo ""
echo "=== Web app: lint ==="
npm run lint
npm run lint:css

echo ""
echo "=== Web app: tests ==="
npx vitest run

echo ""
echo "Pre-commit checks passed."
