{
	"name": "bacon",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"format": "prettier --write .",
		"lint": "eslint \"api/**/*.{js,jsx,ts,tsx}\" \"server/**/*.{js,jsx,ts,tsx}\" \"src/**/*.{js,jsx,ts,tsx}\"",
		"lint:css": "stylelint 'src/**/*.css'",
		"lint:css:fix": "stylelint 'src/**/*.css' --fix",
		"lint:fix": "eslint \"api/**/*.{js,jsx,ts,tsx}\" \"server/**/*.{js,jsx,ts,tsx}\" \"src/**/*.{js,jsx,ts,tsx}\" --fix",
		"preview": "vite preview",
		"prepare": "husky",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"lint-staged": {
		"**/*.{ts,tsx,js,jsx,json,css,md}": "prettier --write",
		"api/**/*.{ts,tsx,js,jsx}": "eslint --max-warnings 0",
		"server/**/*.{ts,tsx,js,jsx}": "eslint --max-warnings 0",
		"src/**/*.{ts,tsx,js,jsx}": "eslint --max-warnings 0",
		"**/*.css": "stylelint --max-warnings 0"
	},
	"dependencies": {
		"googleapis": "^178.0.0",
		"js-cookie": "^3.0.5",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"stylelint": "^16.25.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.36.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest": "^30.0.0",
		"@types/js-cookie": "^3.0.6",
		"@types/node": "^24.6.0",
		"@types/react": "^19.1.16",
		"@types/react-dom": "^19.1.9",
		"@typescript-eslint/eslint-plugin": "^8.46.2",
		"@typescript-eslint/parser": "^8.46.2",
		"@vercel/node": "^30.0.0",
		"@vitejs/plugin-react": "^5.0.4",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.22",
		"globals": "^16.4.0",
		"husky": "^9.1.7",
		"jsdom": "^27.1.0",
		"lint-staged": "^16.4.0",
		"prettier": "^3.6.2",
		"stylelint-config-standard": "^39.0.1",
		"stylelint-order": "^7.0.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.45.0",
		"vite": "^7.3.6",
		"vitest": "^4.0.8"
	},
	"allowScripts": {
		"fsevents@2.3.3": true,
		"esbuild@0.28.1": true
	}
}
